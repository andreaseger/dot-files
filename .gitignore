# Ignore everything by default
!.gitignore


# pattern:
# allow directory
# either let a .gitignore in that directory handle it
# or ignore everything in directory, again
# and allow specific files/subdirectories


# .local -> see .local/.gitignore for exceptions
!/.local

# .config -> see .config/.gitignore for exceptions
!/.config/

# .ssh -> allow only config file
!/.ssh/
/.ssh/*
!/.ssh/config

# .bundle -> allow only  config file
!.bundle
/.bundle/*
!.bundle/config

# root dot-files to allow
!/.xprofile

!/.gemrc

!.gitignore.global
!.gitattributes.global

!.psqlrc
!.tmux.conf

!.vimrc
!.bashrc
